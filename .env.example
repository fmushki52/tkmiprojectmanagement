# Copy to .env.local for local development. Never commit real values.

# Neon pooled connection string (host contains "-pooler"). Use a separate Neon branch/database
# per environment: development, preview and production.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# Better Auth. Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET="replace-with-a-long-random-string"
# Public base URL of the deployment (http://localhost:3000 locally).
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Secret for the scheduled deadline-notification endpoint (/api/cron/deadlines).
# On Vercel, Cron sends it as "Authorization: Bearer $CRON_SECRET".
CRON_SECRET="replace-with-another-random-string"

# File attachments. Development without these variables stores files on disk (.data/uploads).
# Production MUST use an S3-compatible bucket (AWS S3, Cloudflare R2, MinIO...). The bucket must be private.
STORAGE_DRIVER="s3"
S3_BUCKET="your-private-bucket"
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID="replace-me"
S3_SECRET_ACCESS_KEY="replace-me"
# Only for non-AWS services (R2/MinIO). Path-style is usually required for MinIO.
S3_ENDPOINT=""
S3_FORCE_PATH_STYLE="false"
